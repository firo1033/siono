<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Pregunta</title>
  <style>
    body {
      font-family: Arial;
      text-align: center;
      background: #ffe6f0;
      margin-top: 100px;
    }
    button {
      padding: 15px 25px;
      font-size: 18px;
      margin: 10px;
      cursor: pointer;
    }
    #noBtn {
      position: absolute;
    }
    #adminPanel {
      display: none;
      background: white;
      padding: 20px;
      border: 2px solid black;
      margin-top: 30px;
    }
  </style>
</head>
<body>

<h1>¿Saldrías conmigo? 💖</h1>

<button onclick="responder('si')">Sí</button>
<button id="noBtn" onmouseover="moverNo()">No</button>

<div id="adminPanel">
  <h2>Respuestas:</h2>
  <ul id="lista"></ul>
</div>

<!-- Firebase MODERNO -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyADVDUK-jFyqhcE_liEEbGzVx_kKaHRvNI",
  authDomain: "si-o-no-6b48e.firebaseapp.com",
  projectId: "si-o-no-6b48e",
  storageBucket: "si-o-no-6b48e.firebasestorage.app",
  messagingSenderId: "121297882187",
  appId: "121297882187"
};

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  window.responder = async function(valor) {
    await addDoc(collection(db, "respuestas"), {
      respuesta: valor,
      fecha: new Date()
    });
    alert("Respuesta enviada 😎");
  };

  window.moverNo = function() {
    const btn = document.getElementById("noBtn");
    btn.style.top = Math.random() * window.innerHeight + "px";
    btn.style.left = Math.random() * window.innerWidth + "px";
  };

  const PASSWORD = "1234";

  document.addEventListener("keydown", async (e) => {
    if (e.key.toLowerCase() === "p") {
      let input = prompt("Contraseña:");

      if (input === PASSWORD) {
        document.getElementById("adminPanel").style.display = "block";

        const lista = document.getElementById("lista");
        lista.innerHTML = "";

        const querySnapshot = await getDocs(collection(db, "respuestas"));
        querySnapshot.forEach((doc) => {
          const li = document.createElement("li");
          li.textContent = doc.data().respuesta;
          lista.appendChild(li);
        });

      } else {
        alert("❌ Incorrecta");
      }
    }
  });
</script>

</body>
</html>
