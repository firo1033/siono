<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Formulario</title>

<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js"></script>

</head>
<body>

<h2>Formulario</h2>

<form id="formulario">
  <input type="text" id="respuesta" placeholder="Escribe algo" required>
  <button type="submit">Enviar</button>
</form>

<script>

const firebaseConfig = {
  apiKey: "AIzaSyCpcfbLZ3d9W-9wkZs7MBJhAy_XUPz_WKI",
  authDomain: "respuesta-1bc81.firebaseapp.com",
  projectId: "respuesta-1bc81",
  storageBucket: "respuesta-1bc81.firebasestorage.app",
  messagingSenderId: "73585474312",
  appId: "1:73585474312:web:2cddd7de43ff5140fecabd"
};

// INICIALIZAR FIREBASE
const app = firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

// GUARDAR RESPUESTAS
document.getElementById("formulario").addEventListener("submit", async function(e){
  e.preventDefault();

  let valor = document.getElementById("respuesta").value;

  await db.collection("respuestas").add({
    texto: valor,
    fecha: new Date()
  });

  alert("Respuesta enviada");
  document.getElementById("respuesta").value = "";
});

// 🔒 ACCESO SECRETO CON P
document.addEventListener("keydown", async function(e){
  if(e.key.toLowerCase() === "p"){
    let pass = prompt("Contraseña:");
    if(pass === "firo1033"){
      mostrarRespuestas();
    } else {
      alert("Incorrecta");
    }
  }
});

// 👁 VER RESPUESTAS
async function mostrarRespuestas(){
  let snapshot = await db.collection("respuestas").get();

  let contenido = "<h2>RESPUESTAS</h2><ul>";

  snapshot.forEach(doc => {
    contenido += "<li>" + doc.data().texto + "</li>";
  });

  contenido += "</ul>";

  document.body.innerHTML = contenido;
}

</script>

</body>
</html>
